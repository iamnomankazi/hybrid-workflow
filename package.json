{
  "name": "hybrid-workflow",
  "version": "0.1.0",
  "description": "Deterministic per-run Codex execution plane for a native Claude/Opus control plane (Windows).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "hybrid": "bin/hybrid.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec \"test/integration/*.test.mjs\""
  }
}
